APP_NAME="iStore Chile"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=your-neon-host
DB_PORT=5432
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_SSLMODE=require

# --- Santi (chatbot con function calling) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=15

SANTI_FUNCTION_CALLING_ENABLED=true
SANTI_MAX_TOOL_ROUNDS=3
SANTI_MAX_TOOL_CALLS=6
SANTI_DRAFT_TTL_HOURS=48
SANTI_DRAFT_MAX_PER_HOUR=10
SANTI_DRAFT_MAX_SUBTOTAL_CLP=5000000